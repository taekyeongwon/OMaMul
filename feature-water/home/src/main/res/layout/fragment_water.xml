<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.tkw.home.WaterViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_water_background"
        android:padding="20dp"
        android:clipToPadding="false">

        <!-- 헤더 정보 카드 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_header_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/md_theme_light_surface"
            android:translationZ="2dp"
            app:strokeWidth="0dp"
            style="@style/Widget.Material3.CardView.Elevated"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/glass_card_background"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:weightSum="2">

                <!-- 목표량 정보 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_target"
                        android:layout_marginBottom="8dp"
                        app:tint="@color/md_theme_light_primary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/water_target"
                        android:textSize="12sp"
                        android:textColor="@color/md_theme_light_onSurfaceVariant"
                        android:layout_marginBottom="4dp"
                        android:textAppearance="?attr/textAppearanceLabelSmall" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_target_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textColor="@color/md_theme_light_primary"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        tools:text="2000ml" />

                </LinearLayout>

                <!-- 구분선 -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="60dp"
                    android:background="@color/water_light_blue"
                    android:layout_marginHorizontal="16dp" />

                <!-- 다음 알람 정보 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_alarm"
                        android:layout_marginBottom="8dp"
                        app:tint="@color/md_theme_light_primary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/water_next_alarm"
                        android:textSize="12sp"
                        android:textColor="@color/md_theme_light_onSurfaceVariant"
                        android:layout_marginBottom="4dp"
                        android:textAppearance="?attr/textAppearanceLabelSmall" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_next_alarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textColor="@color/md_theme_light_primary"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        tools:text="15:30" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 메인 물 섭취량 시각화 카드 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_water_visualization"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="80dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="@color/md_theme_light_surface"
            android:translationZ="4dp"
            app:strokeWidth="0dp"
            style="@style/Widget.Material3.CardView.Elevated"
            app:layout_constraintTop_toBottomOf="@id/card_header_info"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/glass_card_background"
                android:padding="20dp">

                <!-- 메인 물 컨테이너 -->
                <FrameLayout
                    android:id="@+id/main_water_container"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/tv_encouragement"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    android:layout_margin="8dp">

                    <!-- 물 웨이브 애니메이션 -->
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lotti"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        app:lottie_autoPlay="true"
                        app:lottie_fileName="water_wave.json"
                        app:lottie_loop="true"
                        app:lottie_clipToCompositionBounds="true" />

                    <!-- 섭취량 정보 오버레이 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/modern_info_background"
                        android:padding="24dp"
                        android:elevation="4dp">

                        <!-- 현재 섭취량 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_current_intake"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{Integer.toString(viewModel.amountLiveData.totalIntakeByDate)}"
                                android:textSize="42sp"
                                android:textColor="@color/md_theme_light_primary"
                                android:textAppearance="?attr/textAppearanceDisplayLarge"
                                tools:text="1250" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/unit_ml_no_bracket"
                                android:textSize="16sp"
                                android:textColor="@color/md_theme_light_onSurfaceVariant"
                                android:layout_marginStart="4dp"
                                android:textAppearance="?attr/textAppearanceTitleSmall" />

                        </LinearLayout>

                        <!-- 목표 대비 비율 -->
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_goal_ratio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/md_theme_light_onSurfaceVariant"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="/ 2000ml (62%)" />

                    </LinearLayout>

                </FrameLayout>

                <!-- 격려 메시지 -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_encouragement"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/md_theme_light_onSurfaceVariant"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:layout_margin="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="목표까지 750ml 남았어요! 💪" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- FAB 메뉴 오버레이 (배경 클릭 감지용) -->
        <View
            android:id="@+id/fab_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/fab_pressed_overlay"
            android:visibility="gone"
            android:alpha="0"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- FAB 서브 메뉴 컨테이너 -->
        <LinearLayout
            android:id="@+id/fab_menu_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="84dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            android:alpha="0"
            android:translationZ="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 설정 버튼 -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_cup_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:src="@drawable/ic_settings"
                app:backgroundTint="@color/md_theme_light_secondaryContainer"
                app:tint="@color/md_theme_light_onSecondaryContainer"
                app:elevation="0dp"
                app:fabSize="mini" />

            <!-- 실행 취소 버튼 -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_undo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_remove_drop"
                app:backgroundTint="@color/md_theme_light_tertiaryContainer"
                app:tint="@color/md_theme_light_onTertiaryContainer"
                app:elevation="0dp"
                app:fabSize="mini" />

        </LinearLayout>

        <!-- 메인 플로팅 컵 버튼 -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_current_cup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_cup"
            app:backgroundTint="@color/md_theme_light_primary"
            app:tint="@color/md_theme_light_onPrimary"
            app:elevation="24dp"
            android:translationZ="8dp"
            app:fabSize="normal"
            android:hapticFeedbackEnabled="true"
            style="@style/Widget.Material3.FloatingActionButton.Primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>