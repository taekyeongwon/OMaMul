<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/opaque_dialog_background"
    android:padding="24dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/tv_intake_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/intake_amount"
        android:textColor="@color/black"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <com.tkw.ui.custom.WaterAmountPicker
        android:id="@+id/np_amount"
        android:layout_width="wrap_content"
        android:layout_height="150dp"
        android:selectionDividerHeight="0dp"
        app:minValue="100"
        app:maxValue="3000"
        app:interval="5"
        app:layout_constraintTop_toBottomOf="@id/tv_intake_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>