<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="viewModel"
            type="com.tkw.setting.SettingViewModel" />
    </data>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/glass_surface"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_etc_setting_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/divider">

                <TextView
                    android:id="@+id/tv_language_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_language_title"
                    android:textColor="@color/md_theme_light_onSurface"
                    android:textSize="16sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@id/tv_language"/>
                <TextView
                    android:id="@+id/tv_language"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_theme_light_primary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintTop_toTopOf="@id/tv_language_title"
                    app:layout_constraintRight_toLeftOf="@id/button_language"
                    app:resId="@{viewModel.currentLangResFlow}"
                    tools:text="한국어"/>
                <ImageView
                    android:id="@+id/button_language"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/right_arrow"
                    app:layout_constraintTop_toTopOf="@id/tv_language"
                    app:layout_constraintBottom_toBottomOf="@id/tv_language"
                    app:layout_constraintRight_toRightOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A4A90E2"
                android:layout_marginVertical="12dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/cl_etc_setting_language"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_etc_setting_advertise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/divider"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tv_advertise_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_advertise_title"
                    android:textColor="@color/md_theme_light_onSurface"
                    android:textSize="16sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@id/tv_advertise"/>
                <ImageView
                    android:id="@+id/tv_advertise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/right_arrow"
                    app:layout_constraintTop_toTopOf="@id/tv_advertise_title"
                    app:layout_constraintBottom_toBottomOf="@id/tv_advertise_title"
                    app:layout_constraintRight_toRightOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>