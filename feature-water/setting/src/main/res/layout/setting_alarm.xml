<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="viewModel"
            type="com.tkw.setting.SettingViewModel" />
    </data>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/glass_surface"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_alarm_setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_alarm_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/setting_alarm_title"
                android:textColor="@color/md_theme_light_onSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/tv_alarm"/>
            <ImageView
                android:id="@+id/tv_alarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/right_arrow"
                app:layout_constraintTop_toTopOf="@id/tv_alarm_title"
                app:layout_constraintBottom_toBottomOf="@id/tv_alarm_title"
                app:layout_constraintRight_toRightOf="parent" />

            <View
                android:id="@+id/divider1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A4A90E2"
                android:layout_marginVertical="12dp"
                app:layout_constraintTop_toBottomOf="@id/tv_alarm_title"/>

            <TextView
                android:id="@+id/tv_alarm_mode_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/setting_alarm_mode_title"
                android:textColor="@color/md_theme_light_onSurface"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/divider1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/tv_alarm_mode"/>
            <TextView
                android:id="@+id/tv_alarm_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/md_theme_light_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="@id/tv_alarm_mode_title"
                app:layout_constraintRight_toRightOf="parent"
                app:resId="@{viewModel.alarmModeFlow}"
                tools:text="주기"/>
            <TextView
                android:id="@+id/tv_alarm_schedule_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/setting_alarm_schedule_title"
                android:textColor="@color/md_theme_light_onSurface"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tv_alarm_mode_title"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/tv_alarm_schedule"/>
            <TextView
                android:id="@+id/tv_alarm_schedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{viewModel.alarmScheduleFlow}"
                android:textColor="@color/md_theme_light_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="@id/tv_alarm_schedule_title"
                app:layout_constraintRight_toRightOf="parent"
                tools:text="일, 월, 화"/>
            <TextView
                android:id="@+id/tv_alarm_time_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/setting_alarm_time_title"
                android:textColor="@color/md_theme_light_onSurface"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tv_alarm_schedule_title"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/tv_alarm_time"/>
            <TextView
                android:id="@+id/tv_alarm_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{viewModel.alarmTimeFlow}"
                android:textColor="@color/md_theme_light_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="@id/tv_alarm_time_title"
                app:layout_constraintRight_toRightOf="parent"
                tools:text="오전 08:00 - 오후 11:00"/>
            <TextView
                android:id="@+id/tv_alarm_sound_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/setting_alarm_sound_title"
                android:textColor="@color/md_theme_light_onSurface"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tv_alarm_time_title"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/tv_alarm_sound"/>
            <TextView
                android:id="@+id/tv_alarm_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/md_theme_light_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="@id/tv_alarm_sound_title"
                app:layout_constraintRight_toRightOf="parent"
                app:resId="@{viewModel.alarmRingtoneFlow}"
                tools:text="벨소리"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>