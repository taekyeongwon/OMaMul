<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="viewModel"
            type="com.tkw.setting.SettingViewModel" />
    </data>
    <com.google.android.material.card.MaterialCardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/card_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/glass_surface"
        app:layout_constraintTop_toTopOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">
        <ImageView
            android:id="@+id/iv_image"
            android:layout_width="57dp"
            android:layout_height="57dp"
            android:src="@drawable/account_circle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:tint="@color/md_theme_light_primary"/>
        <TextView
            android:id="@+id/tv_sync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_sync"
            android:textColor="@color/md_theme_light_onSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="@id/iv_image"
            app:layout_constraintBottom_toTopOf="@id/tv_last_sync"
            app:layout_constraintLeft_toRightOf="@id/iv_image"/>
        <TextView
            android:id="@+id/tv_last_sync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/md_theme_light_onSurface"
            android:textSize="12sp"
            android:layout_marginStart="16dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tv_sync"
            app:layout_constraintBottom_toBottomOf="@id/iv_image"
            app:layout_constraintLeft_toRightOf="@id/iv_image"/>
        <ImageView
            android:id="@+id/iv_sync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/sync"
            android:visibility="gone"
            android:layout_marginLeft="6dp"
            app:layout_constraintLeft_toRightOf="@id/tv_last_sync"
            app:layout_constraintTop_toTopOf="@id/tv_last_sync"
            app:layout_constraintBottom_toBottomOf="@id/tv_last_sync"/>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A4A90E2"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/iv_image"/>

        <TextView
            android:id="@+id/tv_total_intake_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_total_intake"
            android:textColor="@color/md_theme_light_onSurface"
            android:textSize="16sp"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <TextView
            android:id="@+id/tv_total_intake"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@{String.valueOf(viewModel.totalIntakeFlow)}"
            android:textColor="@color/md_theme_light_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="end"
            app:layout_constraintLeft_toRightOf="@id/tv_total_intake_title"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_total_intake_title"
            app:layout_constraintBottom_toBottomOf="@id/tv_total_intake_title"
            tools:text="32.65L"/>
        <TextView
            android:id="@+id/tv_total_achieve_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_total_achieve"
            android:textColor="@color/md_theme_light_onSurface"
            android:textSize="16sp"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@id/tv_total_intake_title"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <TextView
            android:id="@+id/tv_total_achieve"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/md_theme_light_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="end"
            app:layout_constraintLeft_toRightOf="@id/tv_total_achieve_title"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_total_achieve_title"
            app:layout_constraintBottom_toBottomOf="@id/tv_total_achieve_title"
            app:prefix="@{viewModel.totalAchieveFlow}"
            app:textRes="@{@string/day}"
            tools:text="15일"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>