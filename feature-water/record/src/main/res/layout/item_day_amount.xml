<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_card_background"
    android:elevation="4dp"
    android:translationZ="2dp"
    android:layout_margin="4dp"
    android:padding="16dp"
    android:clipToPadding="false"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/tv_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_light_primary"
        android:layout_marginLeft="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        tools:text="400ml"/>
    <TextView
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/md_theme_light_onSurfaceVariant"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_amount"
        app:layout_constraintLeft_toLeftOf="parent"
        tools:text="12:00 PM"/>
    <ImageButton
        android:id="@+id/ib_edit"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_edit_water"
        android:background="@drawable/transparent_circle_background"
        android:padding="12dp"
        android:elevation="2dp"
        app:tint="@color/water_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@id/ib_delete"/>
    <ImageButton
        android:id="@+id/ib_delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_delete_water"
        android:background="@drawable/transparent_circle_background"
        android:padding="12dp"
        android:elevation="2dp"
        app:tint="@color/md_theme_light_error"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>