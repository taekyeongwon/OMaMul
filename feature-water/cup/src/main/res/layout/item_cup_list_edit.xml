<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="cup"
            type="com.tkw.domain.model.Cup" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginVertical="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="@{cup.isChecked ? @color/water_blue : @android:color/transparent}"
        app:cardBackgroundColor="@{cup.isChecked ? @color/water_light_blue : @color/glass_surface}"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="?attr/selectableItemBackground">

            <!-- 체크박스 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_checkbox"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/water_blue_variant"
                app:cardBackgroundColor="@{cup.isChecked ? @color/water_blue : @android:color/transparent}"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/iv_check"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    android:visibility="@{cup.isChecked ? android.view.View.VISIBLE : android.view.View.GONE}"
                    app:tint="@android:color/white"/>

                <CheckBox
                    android:id="@+id/cb_delete"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:button="@null"
                    android:checked="@{cup.isChecked}"
                    android:visibility="invisible"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- 컵 아이콘 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_cup_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/water_light_blue"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/card_checkbox">

                <ImageView
                    android:id="@+id/iv_cup"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cup"
                    app:tint="@color/water_blue"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- 컵 정보 -->
            <LinearLayout
                android:id="@+id/layout_cup_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/card_cup_icon"
                app:layout_constraintEnd_toStartOf="@id/card_drag_handle">

                <TextView
                    android:id="@+id/tv_alias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{cup.cupName}"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/water_blue"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="집 물컵"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_water_drop"
                        android:layout_marginEnd="4dp"
                        app:tint="@color/water_blue_variant"/>

                    <TextView
                        android:id="@+id/tv_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/water_blue_variant"
                        app:unit="@{cup.cupAmount}"
                        tools:text="400ml"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 드래그 핸들 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_drag_handle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/water_light_blue"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageButton
                    android:id="@+id/ib_drag"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_drag_handle"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:padding="6dp"
                    app:tint="@color/water_blue"/>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
