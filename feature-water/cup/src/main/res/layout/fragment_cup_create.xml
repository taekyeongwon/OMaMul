<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>
        <variable
            name="viewModel"
            type="com.tkw.cup.CupViewModel" />
    </data>

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/water_gradient_background"
        android:clipToPadding="false"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:clipToPadding="false">

            <!-- 컵 이름 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_cup_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/glass_surface"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/glass_card_background"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_edit"
                            android:layout_marginEnd="8dp"
                            app:tint="@color/water_blue"/>

                        <TextView
                            android:id="@+id/tv_cup_alias_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cup_alias"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/water_blue"/>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/WaterApp.TextInputLayout"
                        app:hintTextColor="@color/water_blue_variant">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_cup_alias"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textSize="16sp"
                            android:text="@={viewModel.cupNameLiveData}"
                            android:hint="@string/cup_alias_hint"
                            android:maxLines="1"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 컵 용량 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_cup_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/glass_surface"
                app:layout_constraintTop_toBottomOf="@id/card_cup_name">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/glass_card_background"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_water_drop"
                            android:layout_marginEnd="8dp"
                            app:tint="@color/water_blue"/>

                        <TextView
                            android:id="@+id/tv_cup_amount_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cup_amount"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/water_blue"/>
                    </LinearLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/glass_card_background"
                        android:padding="16dp">

                        <com.tkw.ui.custom.WaterAmountPicker
                            android:id="@+id/np_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="180dp"
                            android:selectionDividerHeight="0dp"
                            value="@={viewModel.cupAmountLiveData}"
                            app:minValue="100"
                            app:maxValue="5000"
                            app:interval="5"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- 하단 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next"
                style="@style/WaterApp.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@{viewModel.buttonName}"
                android:textSize="16sp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:layout_constraintTop_toBottomOf="@id/card_cup_amount"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>