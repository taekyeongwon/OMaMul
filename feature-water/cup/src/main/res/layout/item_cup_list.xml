<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="cup"
            type="com.tkw.domain.model.Cup" />
        <variable
            name="isSelected"
            type="boolean" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginVertical="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="@{isSelected ? 8 : 4}"
        app:strokeWidth="@{isSelected ? 2 : 0}"
        app:strokeColor="@{isSelected ? @color/water_blue : @android:color/transparent}"
        app:cardBackgroundColor="@{isSelected ? @color/water_light_blue : @color/glass_surface}"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="@drawable/glass_card_background">

            <!-- 컵 아이콘 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_cup_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/cup_icon_large_background"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/iv_cup"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_cup"
                    app:tint="@color/water_blue"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 선택된 컵 배지 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_selected_badge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="-4dp"
                android:layout_marginEnd="-4dp"
                android:background="@drawable/selected_badge_background"
                android:visibility="@{isSelected ? android.view.View.VISIBLE : android.view.View.GONE}"
                app:layout_constraintTop_toTopOf="@id/layout_cup_icon"
                app:layout_constraintEnd_toEndOf="@id/layout_cup_icon">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_check"
                    android:padding="2dp"
                    app:tint="@android:color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 컵 정보 -->
            <LinearLayout
                android:id="@+id/layout_cup_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/layout_cup_icon"
                app:layout_constraintEnd_toStartOf="@id/layout_edit_button">

                <TextView
                    android:id="@+id/tv_alias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{cup.cupName}"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/water_blue"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="집 물컵"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_water_drop"
                        android:layout_marginEnd="4dp"
                        app:tint="@color/water_blue_variant"/>

                    <TextView
                        android:id="@+id/tv_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/water_blue_variant"
                        app:unit="@{cup.cupAmount}"
                        tools:text="400ml"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 편집 버튼 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_edit_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/edit_button_background"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageButton
                    android:id="@+id/ib_edit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_edit"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    app:tint="@color/water_blue"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 드래그 핸들 (숨김 상태) -->
            <ImageButton
                android:id="@+id/ib_drag"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_drag_handle"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:visibility="gone"
                app:tint="@color/water_blue_variant"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
