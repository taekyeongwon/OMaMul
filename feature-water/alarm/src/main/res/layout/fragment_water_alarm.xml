<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:clipToPadding="false"
    android:background="@drawable/gradient_water_background"
    android:padding="16dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false">

        <!-- 알람 지연 카드 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_alarm_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_alarm_delay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">
                <TextView
                    android:id="@+id/tv_alarm_delay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/alarm_delay"
                    android:textColor="@color/md_theme_light_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:paddingVertical="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 알람 소리 섹션 -->
        <TextView
            android:id="@+id/tv_alarm_sound_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alarm_sound_title"
            android:textColor="@color/md_theme_light_primary"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toBottomOf="@id/card_alarm_delay"
            app:layout_constraintLeft_toLeftOf="parent"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_alarm_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:layout_constraintTop_toBottomOf="@id/tv_alarm_sound_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_alarm_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">
                <com.tkw.ui.custom.TextImageView
                    android:id="@+id/tv_alarm_sound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:text="@string/alarm_sound_device"
                    app:src="@drawable/right_arrow"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 알람 모드 섹션 -->
        <TextView
            android:id="@+id/tv_alarm_mode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alarm_mode_title"
            android:textColor="@color/md_theme_light_primary"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toBottomOf="@id/card_alarm_sound"
            app:layout_constraintLeft_toLeftOf="parent"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_alarm_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:layout_constraintTop_toBottomOf="@id/tv_alarm_mode_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_alarm_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">
                <com.tkw.ui.custom.TextImageView
                    android:id="@+id/tv_alarm_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="@string/alarm_mode_period"
                    app:src="@drawable/right_arrow"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 기타 설정 섹션 -->
        <TextView
            android:id="@+id/tv_alarm_etc_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alarm_etc_setting"
            android:textColor="@color/md_theme_light_primary"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toBottomOf="@id/card_alarm_mode"
            app:layout_constraintLeft_toLeftOf="parent"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_alarm_etc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:layout_constraintTop_toBottomOf="@id/tv_alarm_etc_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">
                <com.tkw.ui.custom.TextSwitchView
                    android:id="@+id/tv_alarm_etc_stop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:text="@string/alarm_etc_stop_reached_goal"/>
                <View
                    android:id="@+id/divider2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#1A4A90E2"
                    app:layout_constraintTop_toBottomOf="@id/tv_alarm_etc_stop"/>
                <com.tkw.ui.custom.TextImageView
                    android:id="@+id/tv_fullscreen_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/divider2"
                    app:text="@string/alarm_etc_fullscreen_setting"
                    app:src="@drawable/right_arrow"/>
                <View
                    android:id="@+id/divider3"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#1A4A90E2"
                    app:layout_constraintTop_toBottomOf="@id/tv_fullscreen_setting"/>
                <com.tkw.ui.custom.TextImageView
                    android:id="@+id/tv_exact_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/divider3"
                    app:text="@string/alarm_etc_exact_setting"
                    app:src="@drawable/right_arrow"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
