<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.tkw.alarm.WaterAlarmViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_water_background"
        android:clipToPadding="false"
        android:padding="16dp">

        <!-- 남은 시간 카드 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_remain_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:id="@+id/tv_alarm_remain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_light_primary"
                android:gravity="center"
                android:text="@{viewModel.remainTimeLiveData}"
                tools:text="@string/alarm_detail_empty"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- 알람 모드 섹션 -->
        <TextView
            android:id="@+id/tv_alarm_mode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alarm_detail_mode_title"
            android:textColor="@color/md_theme_light_primary"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toBottomOf="@id/card_remain_time"
            app:layout_constraintLeft_toLeftOf="parent"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_alarm_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:layout_constraintTop_toBottomOf="@id/tv_alarm_mode_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_alarm_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">
                <com.tkw.ui.custom.TextImageView
                    android:id="@+id/tv_alarm_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:src="@drawable/right_arrow"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/card_alarm_mode"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>