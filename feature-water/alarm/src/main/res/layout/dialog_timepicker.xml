<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/glass_card_background">

    <!-- 시작/종료 선택 버튼 카드 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/glass_surface">

        <RadioGroup
            android:id="@+id/rg_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:checkedButton="@id/rb_start"
            android:gravity="center"
            android:padding="16dp">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_start"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/start"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/water_blue"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_end"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/end"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/water_blue"
                android:layout_marginStart="8dp"/>
        </RadioGroup>
    </com.google.android.material.card.MaterialCardView>

    <!-- 시간 선택 카드 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/glass_surface">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_timepicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TimePicker
                android:id="@+id/tp_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:timePickerMode="spinner"
                app:layout_constraintTop_toTopOf="parent"/>

            <TimePicker
                android:id="@+id/tp_end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:timePickerMode="spinner"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>