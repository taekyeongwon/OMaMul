<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_card_background"
    android:clipToPadding="false"
    android:padding="20dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    android:elevation="2dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/tv_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:textColor="@color/md_theme_light_onSurface"
        android:textSize="16sp"
        android:fontFamily="sans-serif"
        android:maxLines="2"
        android:ellipsize="end"
        android:minHeight="48dp"
        android:lineSpacingExtra="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_image"/>

    <ImageView
        android:id="@+id/iv_image"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:visibility="gone"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="@id/tv_text"
        app:layout_constraintBottom_toBottomOf="@id/tv_text"
        app:layout_constraintEnd_toStartOf="@id/sv_switch"
        app:tint="@color/water_blue" />

    <com.tkw.ui.custom.SwitchView
        android:id="@+id/sv_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/tv_text"
        app:layout_constraintBottom_toBottomOf="@id/tv_text"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>