<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ON 상태 -->
    <item android:state_checked="true">
        <layer-list>
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="oval">
                    <size android:width="26dp" android:height="26dp" />
                    <solid android:color="@color/white" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/water_blue" />
                </shape>
            </item>
            <!-- 물방울 아이콘 효과 -->
            <item android:bottom="8dp" android:left="8dp" android:right="8dp" android:top="8dp">
                <shape android:shape="oval">
                    <size android:width="16dp" android:height="16dp" />
                    <solid android:color="@color/water_blue" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- OFF 상태 -->
    <item>
        <layer-list>
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="oval">
                    <size android:width="26dp" android:height="26dp" />
                    <solid android:color="@color/white" />
                    <stroke
                        android:width="1dp"
                        android:color="#BDBDBD" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>