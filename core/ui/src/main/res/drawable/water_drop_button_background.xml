<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 눌린 상태 -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:startColor="@color/water_blue_variant"
                android:endColor="@color/water_blue"
                android:angle="45"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="@color/white" />
        </shape>
    </item>

    <!-- 기본 상태 -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="@color/water_blue"
                android:endColor="@color/water_light_blue"
                android:angle="45"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</selector>