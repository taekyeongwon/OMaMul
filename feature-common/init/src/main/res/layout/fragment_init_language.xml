<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/figma_gradient_background">

    <!-- Progress Indicators Section (64dp top, 24dp horizontal, 32dp bottom) -->
    <LinearLayout
        android:id="@+id/progress_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="64dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <View
            android:id="@+id/indicator_1"
            android:layout_width="32dp"
            android:layout_height="8dp"
            android:background="@drawable/figma_progress_bar"/>

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"/>

        <View
            android:id="@+id/indicator_2"
            android:layout_width="32dp"
            android:layout_height="8dp"
            android:background="@drawable/figma_indicator_inactive"/>

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"/>

        <View
            android:id="@+id/indicator_3"
            android:layout_width="32dp"
            android:layout_height="8dp"
            android:background="@drawable/figma_indicator_inactive"/>

    </LinearLayout>

    <!-- Title (32dp below progress, 48dp bottom margin) -->
    <TextView
        android:id="@+id/tv_language_title"
        android:layout_width="327dp"
        android:layout_height="32dp"
        android:text="@string/init_language_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/progress_section"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

    <!-- Language Selection Cards (48dp below title) -->
    <RadioGroup
        android:id="@+id/rg_language"
        android:layout_width="327dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/tv_language_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- Korean Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_ko"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/figma_glass_border"
            app:cardBackgroundColor="@color/figma_glass_card">

            <RadioButton
                android:id="@+id/rb_ko"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="17dp"
                android:layout_marginEnd="17dp"
                android:button="@null"
                android:drawableEnd="@drawable/figma_radio_selector"
                android:background="@drawable/ripple_effect"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:text="@string/lang_ko"/>

        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"/>

        <!-- English Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_en"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/figma_glass_border"
            app:cardBackgroundColor="@color/figma_glass_card">

            <RadioButton
                android:id="@+id/rb_en"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="17dp"
                android:layout_marginEnd="17dp"
                android:button="@null"
                android:drawableEnd="@drawable/figma_radio_selector"
                android:background="@drawable/ripple_effect"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:text="@string/lang_en"/>

        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"/>

        <!-- Japanese Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_jp"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/figma_glass_border"
            app:cardBackgroundColor="@color/figma_glass_card">

            <RadioButton
                android:id="@+id/rb_jp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="17dp"
                android:layout_marginEnd="17dp"
                android:button="@null"
                android:drawableEnd="@drawable/figma_radio_selector"
                android:background="@drawable/ripple_effect"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:text="@string/lang_jp"/>

        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"/>

        <!-- Chinese Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_cn"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/figma_glass_border"
            app:cardBackgroundColor="@color/figma_glass_card">

            <RadioButton
                android:id="@+id/rb_cn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="17dp"
                android:layout_marginEnd="17dp"
                android:button="@null"
                android:drawableEnd="@drawable/figma_radio_selector"
                android:background="@drawable/ripple_effect"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:text="@string/lang_cn"/>

        </com.google.android.material.card.MaterialCardView>

    </RadioGroup>

    <!-- Next Button (32dp bottom padding, 24dp horizontal) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_next"
        android:layout_width="327dp"
        android:layout_height="48dp"
        android:text="@string/next"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/figma_blue_primary"
        app:cornerRadius="16dp"
        app:elevation="8dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
