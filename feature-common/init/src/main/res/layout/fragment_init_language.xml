<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:padding="24dp"
    android:clipToPadding="false"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Progress Indicator -->
    <TextView
        android:id="@+id/first_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="1"
        android:background="@drawable/step_indicator_active"
        android:gravity="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:elevation="4dp"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toLeftOf="@id/first_line"/>

    <View
        android:id="@+id/first_line"
        android:layout_width="30dp"
        android:layout_height="2dp"
        android:background="@color/water_blue"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        app:layout_constraintTop_toTopOf="@id/first_icon"
        app:layout_constraintBottom_toBottomOf="@id/first_icon"
        app:layout_constraintLeft_toRightOf="@id/first_icon"
        app:layout_constraintRight_toLeftOf="@id/second_icon"/>

    <TextView
        android:id="@+id/second_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="2"
        android:background="@drawable/step_indicator_inactive"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintLeft_toRightOf="@id/first_line"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toLeftOf="@id/second_line"/>

    <View
        android:id="@+id/second_line"
        android:layout_width="30dp"
        android:layout_height="2dp"
        android:background="#CCCCCC"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        app:layout_constraintTop_toTopOf="@id/first_icon"
        app:layout_constraintBottom_toBottomOf="@id/first_icon"
        app:layout_constraintLeft_toRightOf="@id/second_icon"
        app:layout_constraintRight_toLeftOf="@id/third_icon"/>

    <TextView
        android:id="@+id/third_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="3"
        android:background="@drawable/step_indicator_inactive"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintLeft_toRightOf="@id/second_line"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

    <!-- Title Section -->
    <TextView
        android:id="@+id/tv_language_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/init_language_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/first_icon"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <!-- Language Selection Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/glass_surface"
        app:layout_constraintTop_toBottomOf="@id/tv_language_title">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <RadioGroup
                android:id="@+id/rg_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent">

                <RadioButton
                    android:id="@+id/rb_ko"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:drawableRight="@drawable/radio_selector"
                    android:button="@null"
                    android:background="@drawable/ripple_effect"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_vertical"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:text="@string/lang_ko"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider_light"/>

                <RadioButton
                    android:id="@+id/rb_en"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:drawableRight="@drawable/radio_selector"
                    android:button="@null"
                    android:background="@drawable/ripple_effect"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_vertical"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:text="@string/lang_en"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider_light"/>

                <RadioButton
                    android:id="@+id/rb_jp"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:drawableRight="@drawable/radio_selector"
                    android:button="@null"
                    android:background="@drawable/ripple_effect"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_vertical"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:text="@string/lang_jp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider_light"/>

                <RadioButton
                    android:id="@+id/rb_cn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:drawableRight="@drawable/radio_selector"
                    android:button="@null"
                    android:background="@drawable/ripple_effect"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_vertical"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:text="@string/lang_cn"/>
            </RadioGroup>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Next Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/next"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="4dp"
        android:backgroundTint="@color/water_blue"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>