<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/figma_gradient_background">

    <!-- Progress Indicators Section (64dp top, 32dp bottom) -->
    <LinearLayout
        android:id="@+id/progress_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="64dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <View
            android:id="@+id/indicator_1"
            android:layout_width="32dp"
            android:layout_height="8dp"
            android:background="@drawable/figma_indicator_inactive"/>

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"/>

        <View
            android:id="@+id/indicator_2"
            android:layout_width="32dp"
            android:layout_height="8dp"
            android:background="@drawable/figma_progress_bar"/>

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"/>

        <View
            android:id="@+id/indicator_3"
            android:layout_width="32dp"
            android:layout_height="8dp"
            android:background="@drawable/figma_indicator_inactive"/>

    </LinearLayout>

    <!-- Title (32dp below progress, 48dp bottom margin) -->
    <TextView
        android:id="@+id/tv_time_title"
        android:layout_width="327dp"
        android:layout_height="32dp"
        android:text="@string/init_time_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/progress_section"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

    <!-- Time Cards Section (48dp below title) -->
    <LinearLayout
        android:id="@+id/time_cards"
        android:layout_width="327dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/tv_time_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- Wakeup Time Card (327x102dp, 25dp padding) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_wakeup"
            android:layout_width="match_parent"
            android:layout_height="102dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/figma_glass_border"
            app:cardBackgroundColor="@color/figma_glass_card">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="25dp">

                <!-- Left Section (93.33dp width, 52dp height) -->
                <LinearLayout
                    android:id="@+id/wakeup_label_section"
                    android:layout_width="93dp"
                    android:layout_height="52dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/tv_wakeup_time"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        tools:text="07:00"/>

                </LinearLayout>

                <!-- Right Icon Section (32x32dp) -->
                <ImageView
                    android:id="@+id/iv_wakeup_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ico_arrow_right"
                    app:tint="@color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"/>

        <!-- Sleep Time Card (327x102dp, 25dp padding) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_sleep"
            android:layout_width="match_parent"
            android:layout_height="102dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/figma_glass_border"
            app:cardBackgroundColor="@color/figma_glass_card">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="25dp">

                <!-- Left Section (93.33dp width, 52dp height) -->
                <LinearLayout
                    android:id="@+id/sleep_label_section"
                    android:layout_width="93dp"
                    android:layout_height="52dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/tv_sleep_time"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        tools:text="23:00"/>

                </LinearLayout>

                <!-- Right Icon Section (32x32dp) -->
                <ImageView
                    android:id="@+id/iv_sleep_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ico_arrow_right"
                    app:tint="@color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Next Button (32dp bottom padding, 24dp horizontal) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_next"
        android:layout_width="327dp"
        android:layout_height="48dp"
        android:text="@string/next"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/figma_blue_primary"
        app:cornerRadius="16dp"
        app:elevation="8dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
