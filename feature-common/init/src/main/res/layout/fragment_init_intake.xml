<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/figma_gradient_background"
    android:clipToPadding="false">

    <!-- Progress Indicator Section -->
    <LinearLayout
        android:id="@+id/indicator_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="64dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="32dp"
            android:layout_height="8dp"
            android:background="@drawable/figma_indicator_inactive" />

        <View
            android:layout_width="32dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/figma_indicator_inactive" />

        <View
            android:layout_width="32dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/figma_progress_bar" />
    </LinearLayout>

    <!-- Content Section -->
    <LinearLayout
        android:id="@+id/content_section"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/indicator_container"
        app:layout_constraintBottom_toTopOf="@id/button_section"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_intake_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/init_intake_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginBottom="48dp" />

        <!-- Intake Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_intake"
            android:layout_width="194dp"
            android:layout_height="354dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_border"
            app:cardBackgroundColor="@color/glass_surface_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="33dp">

                <!-- Icon Area -->
                <ImageView
                    android:id="@+id/iv_intake_icon"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/ico_water_drop"
                    android:layout_marginBottom="24dp" />

                <!-- Amount Picker -->
                <com.tkw.ui.custom.WaterAmountPicker
                    android:id="@+id/np_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="124dp"
                    android:selectionDividerHeight="0dp"
                    app:minValue="100"
                    app:maxValue="3000"
                    app:interval="50" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/glass_border"
                    android:layout_marginTop="24dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Adjustment Buttons -->
        <LinearLayout
            android:id="@+id/adjustment_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="48dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_decrease"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="-"
                android:textSize="20sp"
                android:textColor="@color/white"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/glass_surface_20"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_border"
                app:elevation="0dp"
                app:rippleColor="@color/glass_surface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_increase"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="+"
                android:textSize="20sp"
                android:textColor="@color/white"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/glass_surface_20"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_border"
                app:elevation="0dp"
                app:rippleColor="@color/glass_surface" />
        </LinearLayout>
    </LinearLayout>

    <!-- Button Section -->
    <LinearLayout
        android:id="@+id/button_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingBottom="32dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/complete"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/figma_blue_primary"
            app:elevation="4dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
